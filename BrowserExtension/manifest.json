{
  "manifest_version": 3,
  "name": "TaskDock 下载进度",
  "version": "0.3.1",
  "description": "每个下载在 TaskDock 中独立显示，标题为文件名，仅本机通信。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TaskDock 下载进度",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
